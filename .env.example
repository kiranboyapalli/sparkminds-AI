# SparkMinds AI — Environment Configuration Template
# Copy to .env for local development or configure in your Cloud Hosting Dashboard (Render, Railway, Vercel, Netlify)

# 1. Environment Mode ("development", "preview", or "production")
SPARKMINDS_ENV=production

# 2. AI Model Configuration (Optional — falls back to deterministic curriculum-verified engine when unset)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Frontend & CORS Configuration
FRONTEND_ORIGIN=https://sparkminds-ai.onrender.com
CORS_ORIGINS=https://sparkminds-ai.onrender.com,http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# 4. Frontend Build-Time API Base URL (Leave empty when serving Frontend + Backend from the same domain/Dockerfile; set to https://your-backend-url.com when hosting Frontend separately on Vercel/Netlify)
VITE_API_BASE_URL=

# 5. Gmail SMTP Email OTP Verification (Configure in Railway / Production Environment Variables; never hardcode credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SparkMinds AI

