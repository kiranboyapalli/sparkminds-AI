# EDUSPARK AI Backend Environment Variables
# Copy this file to .env and add your real Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EDUSPARK_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Gmail SMTP Email OTP Verification (Never commit real credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SparkMinds AI

